---
import servicesData from "../data/services-data.json";
import businessConfig from "../data/business-config.json";

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const whyUsLink = isHome ? "#why-choose-us" : "#why-us";
const processLink = "#process";
const contactLink = "#quote";

const services = servicesData.map((s) => ({
  name: s.breadcrumbsCurrent || s.title.split('|')[0].trim(),
  path: `/${s.slug}`
}));
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <div class="logoContainer">
        <a href="/">
          <span class="logoTitle">{businessConfig.name.split(' ')[0].toUpperCase()}</span>
          <span class="logoSubtitle">{businessConfig.name.split(' ').slice(1).join(' ')}</span>
        </a>
      </div>
      
      <div class="navLinks">
        <!-- Services Dropdown -->
        <div class="dropdownContainer">
          <button class="navLink dropdownTrigger">
            Services <span class="chevron">▼</span>
          </button>
          <div class="dropdownMenu">
            <div class="dropdownGrid">
              {services.map((service) => (
                <a href={service.path} class="dropdownItem">
                  {service.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href={whyUsLink} class="navLink">
          Why Us
        </a>
        
        <a href={processLink} class="navLink">
          Process
        </a>
        
        <a href={contactLink} class="navLink">
          Contact
        </a>
      </div>

      <a href={`tel:${businessConfig.phone.replace(/\D/g, '')}`} class="navPhoneBtn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2"
          strokeLinecap="round"
          strokeLinejoin="round"
          class="phoneIcon"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>{businessConfig.phone}</span>
      </a>
    </nav>
  </div>
</header>

<style>
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 80px;
  background-color: rgba(var(--color-surface-rgb), 0.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(var(--color-text-heading-rgb), 0.08);
  z-index: 100;
  display: flex;
  align-items: center;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.logoContainer {
  display: flex;
  flex-direction: column;
}

.logoContainer a {
  display: flex;
  flex-direction: column;
  text-decoration: none;
}

.logoTitle {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 0.02em;
  line-height: 1.1;
}

.logoSubtitle {
  font-size: 0.7rem;
  color: var(--color-text-body);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
  margin-top: 0.15rem;
}

.navLinks {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.navLink {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--color-text-heading);
  text-decoration: none;
  transition: color 0.2s ease;
}

.navLink:hover {
  color: var(--color-primary);
}

.navPhoneBtn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.2rem;
  background-color: var(--color-primary);
  color: #fff !important;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  box-shadow: 0 4px 10px rgba(var(--color-primary-rgb), 0.25);
  transition: all 0.2s ease;
  text-decoration: none;
  white-space: nowrap;
}

.navPhoneBtn:hover {
  background-color: var(--color-accent);
  transform: translateY(-1px);
}

.phoneIcon {
  flex-shrink: 0;
  color: #fff;
}

/* Services Dropdown Styles */
.dropdownContainer {
  position: relative;
}

.dropdownTrigger {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: none;
  border: none;
  cursor: pointer;
  outline: none;
  padding: 0;
}

.chevron {
  font-size: 0.65rem;
  transition: transform 0.2s ease;
  display: inline-block;
}

.dropdownContainer:hover .chevron {
  transform: rotate(180deg);
}

.dropdownMenu {
  position: absolute;
  top: calc(100% + 15px);
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 16px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(12px);
  padding: 1.5rem;
  width: 440px;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.dropdownMenu::before {
  content: "";
  position: absolute;
  top: -20px;
  left: 0;
  right: 0;
  height: 20px;
}

.dropdownContainer:hover .dropdownMenu {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.dropdownGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem 1.25rem;
}

.dropdownItem {
  font-size: 0.9rem;
  color: var(--color-text-body);
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s ease;
  padding: 0.25rem 0;
  display: inline-block;
}

.dropdownItem:hover {
  color: var(--color-primary);
  transform: translateX(3px);
}

/* Responsiveness */
@media (max-width: 768px) {
  .navLinks {
    display: none;
  }
}

@media (max-width: 480px) {
  .logoTitle {
    font-size: 1.2rem;
  }
  .logoSubtitle {
    font-size: 0.55rem;
    letter-spacing: 0.05em;
  }
  .navPhoneBtn {
    padding: 0.5rem 0.8rem;
    font-size: 0.8rem;
    gap: 0.3rem;
  }
}
</style>
