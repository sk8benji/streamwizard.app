<section id="formats" class="py-20 sm:py-28 bg-white border-t border-slate-100">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="badge-pill mb-4">Formatos Profesionales</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 tracking-tight mb-4">
        Listo para tu <span class="text-gradient">Flujo de Edición</span>
      </h2>
      <p class="text-slate-600 text-lg">
        Las pistas de audio, video y transcripción de Stream Wizard son compatibles de forma nativa con cualquier software de edición o DAW.
      </p>
    </div>

    <!-- Integrations Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-4xl mx-auto">
      <div class="p-6 rounded-2xl border border-slate-200/80 bg-slate-50/50 hover:bg-white hover:border-cyan-200 hover:shadow-md transition-all text-center group">
        <div class="w-12 h-12 mx-auto rounded-xl bg-purple-100/70 text-purple-700 flex items-center justify-center font-black text-lg mb-3 group-hover:scale-110 transition-transform">
          Pr
