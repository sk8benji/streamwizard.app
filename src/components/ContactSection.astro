---
import LeadForm from './LeadForm.tsx';
---

<section id="contact" class="py-20 sm:py-28 bg-slate-50/70 border-t border-slate-100 relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center max-w-6xl mx-auto">
      <!-- Left Column: Value Context -->
      <div class="lg:col-span-5">
        <span class="badge-pill mb-4">Comienza Hoy</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 tracking-tight mb-6">
          ¿Listo para Grabar tu Próximo Podcast en <span class="text-gradient">Calidad de Estudio?</span>
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8">
          Únete a podcasters, creadores de contenido, periodistas y agencias que confían en Stream Wizard para obtener pistas maestras aisladas y transcripciones automáticas.
        </p>

        <div class="space-y-4 border-t border-slate-200/80 pt-6">
          <div class="flex items-center gap-3 text-slate-700 text-sm font-semibold">
            <span class="w-6 h-6 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center text-xs">✓</span>
            Acceso inmediato al estudio en la nube
          </div>
          <div class="flex items-center gap-3 text-slate-700 text-sm font-semibold">
            <span class="w-6 h-6 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center text-xs">✓</span>
            Grabación local por pistas separadas (WAV 48kHz + 4K)
          </div>
          <div class="flex items-center gap-3 text-slate-700 text-sm font-semibold">
            <span class="w-6 h-6 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center text-xs">✓</span>
            Transcripción con IA automática incluida
          </div>
          <div class="flex items-center gap-3 text-slate-700 text-sm font-semibold">
            <span class="w-6 h-6 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center text-xs">✓</span>
            Contacto directo: <a href="mailto:info@streamwizard.app" class="text-cyan-600 underline">info@streamwizard.app</a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <LeadForm client:load />
      </div>
    </div>
  </div>
</section>
